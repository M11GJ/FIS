# ビルドステージ
FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_DCC_CLIENT_ID=""
ARG VITE_DCC_REDIRECT_URI=""
ARG VITE_DCC_SCOPES="openid profile"
ENV VITE_DCC_CLIENT_ID=$VITE_DCC_CLIENT_ID
ENV VITE_DCC_REDIRECT_URI=$VITE_DCC_REDIRECT_URI
ENV VITE_DCC_SCOPES=$VITE_DCC_SCOPES

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine

RUN mkdir -p /usr/share/nginx/html/admin
COPY --from=build /app/dist /usr/share/nginx/html/shu-binran
COPY nginx.fis.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
