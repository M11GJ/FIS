# DCC Loginで登録したFIS用Public ClientのID
VITE_DCC_CLIENT_ID=dcc_0yneIL16eyD4Z-VzkEO69kA6

# DCC Loginに登録するRedirect URIと完全一致させる
# 本番: DCCホスティングの公開URL（末尾 /shu-binran/）
# ローカル例: http://localhost:5173/shu-binran/
VITE_DCC_REDIRECT_URI=https://fis--gunn0511.shu-dcc.net/shu-binran/

# offline_accessはブラウザ版では要求しない
VITE_DCC_SCOPES=openid profile

# DCC LoginトークンのAudience検証にも同じClient IDを使用します
# .shu-dcc.net以外で公開する場合だけ追加ホストを指定
FIS_ALLOWED_HOSTS=
